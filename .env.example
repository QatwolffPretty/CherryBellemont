APP_NAME="Cherry Bellemont"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Production: APP_ENV=production, APP_DEBUG=false, and APP_URL=https://your-domain.example

# Only list the IP addresses or CIDR ranges of your trusted reverse proxy or load balancer.
TRUSTED_PROXIES=

DUITNOW_ACCOUNT_NAME=
DUITNOW_ID=
DUITNOW_BANK_NAME=
DUITNOW_QR_PATH=
DUITNOW_PAYMENT_INSTRUCTIONS=
DUITNOW_SUPPORT_CONTACT=

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=myr

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cherry_bellemont
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_ENCRYPTION=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@cherrybellemont.com
MAIL_FROM_NAME="${APP_NAME}"
ADMIN_NOTIFICATION_EMAIL=
LOW_STOCK_THRESHOLD=3

STORE_COMPANY_NAME="Cherry Bellemont"
STORE_SUPPORT_EMAIL=support@example.com
STORE_GENERAL_EMAIL=hello@example.com
STORE_BUSINESS_ADDRESS=
STORE_LOGO_PATH=
STORE_THREADS_URL=https://threads.net/@yourusername
STORE_INSTAGRAM_URL=https://instagram.com/yourusername
STORE_FACEBOOK_URL=https://facebook.com/yourpage

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
